# 统一换行：文本入库用 LF，检出按平台
* text=auto eol=lf

# PowerShell 脚本必须 CRLF + UTF-8 BOM（本机 PS 5.1 坑：混行会吞变量赋值）
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 文档与配置保持 LF
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# 二进制
*.png binary
*.jpg binary
*.zip binary
